<?xml version="1.0" encoding="utf-8"?>
<keyboard name="QWERTY (US)" script="latin" bottom_row="false">
  <row>
    <key c="q" ne="1" se="loc esc"/>
    <key c="w" nw="~" ne="2" sw="\@"/>
    <key c="e" nw="!" ne="3" sw="\#" se="loc €"/>
    <key c="r" ne="4" sw="$"/>
    <key c="t" ne="5" sw="%"/>
    <key c="y" ne="6" sw="^"/>
    <key c="u" ne="7" sw="&amp;"/>
    <key c="i" ne="8" sw="*"/>
    <key c="o" ne="9" sw="(" se=")"/>
    <key c="p" ne="0"/>
  </row>

  <!-- Home row with 2 side "slots" (0.5 width each) -->
  <row>
    <!-- Left slot: top = clipboard (optional), bottom = 123+ numeric (fixed) -->
    <key width="0.5" c="loc f11_placeholder" n="loc switch_clipboard" s="switch_numeric"/>
    <key c="a" nw="loc tab" ne="`"/>
    <key c="s" ne="loc §" sw="loc ß"/>
    <key c="d"/>
    <key c="f"/>
    <key c="g" ne="-" sw="_"/>
    <key c="h" ne="=" sw="+"/>
    <key c="j" se="}" sw="{"/>
    <key c="k" sw="[" se="]"/>
    <key c="l" ne="|" sw="\\"/>
    <!-- Right slot: top = emoji (fixed), bottom = change method (optional) -->
    <key width="0.5" c="loc f12_placeholder" n="switch_emoji" s="loc change_method"/>
  </row>

  <row>
    <key width="1.5" c="shift" ne="loc capslock"/>
    <key c="z"/>
    <key c="x" ne="loc †"/>
    <key c="c" ne="&lt;" sw="."/>
    <key c="v" ne="&gt;" sw=","/>
    <key c="b" ne="\?" sw="/"/>
    <key c="n" ne=":" sw=";"/>
    <key c="m" ne="&quot;" sw="'"/>
    <key width="1.5" c="backspace" ne="delete"/>
  </row>

  <!-- Custom bottom row for this layout only (copied from res/xml/bottom_row.xml),
       with the 4 small buttons removed from Ctrl/Fn to reduce clutter.
       We keep config (gear) on Fn, as requested. -->
  <row height="0.95">
    <!-- Ctrl: keep greekmath/meta locations, remove clipboard/numeric -->
    <key width="1.7"
         key0="ctrl"
         key1="loc switch_greekmath"
         key2="loc meta"/>
    <!-- Fn: keep alt + config, remove change_method + emoji -->
    <key width="1.1"
         key0="fn"
         key1="loc alt"
         key4="config"/>
    <!-- Space: keep cursor slider + layout switch forward/back -->
    <key width="4.4"
         key0="space"
         key7="switch_forward"
         key8="switch_backward"
         key5="cursor_left"
         key6="cursor_right"/>
    <!-- Arrows block -->
    <key width="1.1"
         key0="loc compose"
         key7="up"
         key6="right"
         key5="left"
         key8="down"
         key1="loc home"
         key2="loc page_up"
         key3="loc end"
         key4="loc page_down"/>
    <!-- Enter -->
    <key width="1.7"
         key0="enter"
         key1="loc voice_typing"
         key2="action"/>
  </row>
</keyboard>
